APP_NAME="InteTeam Garage"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# MUST include the port. route('auth.callback') builds the OAuth redirect_uri
# from APP_URL; without :8085 it will not match the redirect_uri whitelisted for
# the garage clients in SSO (inteteam_sso/config/apps.php).
APP_URL=http://localhost:8085

PORT=8085
PHPMYADMIN_PORT=8086

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=inteteam_garage
DB_USERNAME=garage
DB_PASSWORD=GaragePass2026!
DB_ROOT_PASSWORD=GarageRoot2026!

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=GarageRedis2026!
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="garage@inte.team"
MAIL_FROM_NAME="${APP_NAME}"

# Google Cloud Storage
GCS_PROJECT_ID=
GCS_KEY_FILE_PATH=
GCS_BUCKET=
GCS_SIGNED_URL_EXPIRY_MINUTES=30

# InteTeam CRM API
# Browser-facing base URL of the CRM.
CRM_API_URL=
# Container-to-container base URL (shared proxy-tier network) — avoids a public
# round trip for internal calls. Defaults to CRM_API_URL when empty.
CRM_INTERNAL_URL=
# Bearer token for the CRM's internal/* endpoints. Must equal the CRM's own
# services.internal.token (CRM_INTERNAL_TOKEN there) — its VerifyInternalToken
# middleware reads Authorization: Bearer and ignores custom headers.
CRM_INTERNAL_TOKEN=
# Legacy name, still read as a fallback for CRM_INTERNAL_TOKEN.
CRM_API_SECRET=
# Which CRM company (tenant) this deployment belongs to. The internal endpoints
# key on the ULID; the customer SSO-exchange route takes the slug in its path.
# Normally auto-filled per garage from the SSO company_id claim on the first
# admin login — these are the app-wide fallback.
CRM_COMPANY_ID=
CRM_COMPANY_SLUG=
# Enable only once the CRM exposes GET /api/v1/internal/customers/{id}. While it
# is absent, a missing route answers 404 and the vehicle form would read that as
# "customer not found", blocking vehicle creation.
# See docs/features/crm-integration/contract.md
CRM_CUSTOMER_LOOKUP_BY_ID_ENABLED=false

# Shared secret for the two server-to-server surfaces: the CRM payment webhook
# (X-Internal-Secret) and the internal job API (X-Garage-Secret). Both fail
# closed when this is empty — leaving it unset does NOT disable auth.
GARAGE_INTERNAL_SECRET=
# Turn on once the CRM ships recipient_type=staff on /internal/notifications.
GARAGE_STAFF_NOTIFICATIONS_VIA_CRM_ENABLED=false

# SSO (mechanic dashboard)
# SSO_URL is server-side (container-to-container: token exchange + userinfo).
# SSO_PUBLIC_URL is what the browser is redirected to. In Docker these differ —
# the container's localhost is not the host's. Defaults to SSO_URL when empty.
SSO_URL=
SSO_PUBLIC_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=

# SSO (customer account portal — separate OAuth2 client, redirect_uri = /account/callback)
SSO_CUSTOMER_CLIENT_ID=
SSO_CUSTOMER_CLIENT_SECRET=

# One-shot bootstrap of the first garage_admin on a fresh environment. When set,
# post-deploy.sh calls `php artisan garage:bootstrap-admin --email=…` which
# firstOrCreates Garage(slug=test-garage) + User + Mechanic(role=garage_admin).
# Idempotent — leave set or clear once the admin exists.
GARAGE_BOOTSTRAP_ADMIN_EMAIL=

# DVLA Vehicle Enquiry Service (MOT + Road Tax expiry lookup)
# Register at: https://register-for-the-vehicle-enquiry-service-vehicle-checker-api.service.gov.uk/
DVLA_VES_URL=https://driver-vehicle-licensing.api.gov.uk/vehicle-enquiry/v1/vehicles
DVLA_VES_API_KEY=
DVLA_VES_TIMEOUT=10

# LLM Translation
OPENAI_API_KEY=
TRANSLATION_MODEL=gpt-4o-mini
DETECT_MODEL=gpt-4o-mini

# Comma-separated origins allowed to call portal/* and api/*. Empty = no
# cross-origin access (same-origin browsing still works). Set to the CRM app
# domain plus any white-label portal domains.
CORS_ALLOWED_ORIGINS=

# Playwright E2E — override the base URL when running outside the compose
# network (the runner defaults to http://nginx). See tests/e2e/README.md.
E2E_BASE_URL=

VITE_APP_NAME="${APP_NAME}"
